{
  "name": "omniclaude",
  "version": "1.1.1",
  "description": "Cross-platform CLI & TUI manager for Claude Code and OmniRoute with singleton server lifecycle management and zero-friction patching",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "omniclaude": "bin/omniclaude.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node bin/omniclaude.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "omniroute",
    "claude-code",
    "claude",
    "ai",
    "router",
    "tui",
    "cli"
  ],
  "author": "Rubén Hidalgo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RubizZ/omniclaude.git"
  },
  "bugs": {
    "url": "https://github.com/RubizZ/omniclaude/issues"
  },
  "homepage": "https://github.com/RubizZ/omniclaude#readme",
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^14.0.3",
    "open": "^10.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
